              "hint_en": "Recommended 1.0 in thinking mode"
            },
            "top_p": {
              "show": true,
              "min": 0,
              "max": 1,
              "step": 0.05,
              "hint": "官方建议 1.0",
              "hint_en": "Official recommendation: 1.0"
            },
            "max_tokens": {
              "show": true,
              "min": 1024,
              "max": 393216,
              "step": 1024,
              "hint": "输出上限 393216，别把思考预算卡太死",
              "hint_en": "Output cap 393216; don't squeeze the thinking budget"
            },
            "thinking": {
              "mode": "toggle",
              "label": "深度思考",
              "hint": "开启后返回 reasoning_content，并在工具调用回合回传",
              "hint_en": "Returns reasoning_content and echoes it back on tool turns",
              "label_en": "Deep thinking"
            },
            "reasoning_effort": {
              "show": true,
              "options": [
                "low",
                "high",
                "max"
              ],
              "hint": "越高越愿意长考",
              "hint_en": "Higher values encourage longer deliberation"
            }
          },
          "tagline_en": "1M context · native tool calls"
        }
      ],
      "name_en": "DeepSeek"
    },
