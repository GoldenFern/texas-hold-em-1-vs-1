      "models": [
        {
          "id": "deepseek-flash",
          "name": "DeepSeek V4.1 Flash",
          "tagline": "1M 上下文 · 原生工具调用",
          "context_window": 1048576,
          "max_output": 393216,
          "defaults": {
            "temperature": 1.0,
            "top_p": 1.0,
            "max_tokens": 32768,
            "thinking": true,
